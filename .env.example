# TONIGHT, variables d'environnement
#
# ─────────────────────────────────────────────────────────────
# TMDB (The Movie Database), source de données principale
# ─────────────────────────────────────────────────────────────
#
# 1. Crée un compte sur https://www.themoviedb.org/
# 2. Paramètres → API → crée une clé API (v3) ou un "API Read Access Token" (v4)
# 3. Renseigne UNE des deux variables ci-dessous dans `.env.local`
#
# Option A (recommandée) : token v4 "API Read Access Token"
# TMDB_READ_ACCESS_TOKEN=eyJhbGciOiJIUzI1NiJ9...
#
# Option B : clé API v3 (32 caractères)
# TMDB_API_KEY=0123456789abcdef0123456789abcdef
#
# Sans aucun identifiant, TONIGHT démarre en MODE DÉMO : il utilise un petit
# catalogue local embarqué (~120 titres réels, données vérifiées à la main) afin
# que le moteur, le parser et toute l'interface restent 100% fonctionnels.
# Les affiches TMDB ne sont alors pas disponibles (visuels générés localement).
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Langue et région utilisées pour TMDB (FR par défaut).
TONIGHT_LANGUAGE=fr-FR
TONIGHT_REGION=FR

# Taille du pool enrichi. 70 localement ; utiliser 16 sur Cloudflare Workers
# Free pour rester sous sa limite de 50 sous-requêtes externes.
TONIGHT_POOL_TARGET_SIZE=70
